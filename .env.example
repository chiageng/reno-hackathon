# =============================================================================
# Reno — environment variables
# =============================================================================
# Copy this file to `.env.local` and fill in real values. `.env.local` is
# git-ignored and is loaded automatically by `next dev` and `next build`.
#
# Two distinct kinds of variables — DO NOT mix them up:
#
#   1. Server-only — read inside Route Handlers (src/app/api/**) and
#      src/lib/{openai,elevenlabs,gemini}.ts. NEVER prefix with NEXT_PUBLIC_.
#      Prefixing leaks the value into the browser bundle.
#
#   2. Public (NEXT_PUBLIC_*) — safe to expose to the browser.
#
# All keys below MUST be set on Vercel (Project → Settings → Environment
# Variables) before deploying. Use the SAME names there.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. SERVER-ONLY (do NOT prefix with NEXT_PUBLIC_)
# -----------------------------------------------------------------------------

# --- OpenAI (REQUIRED) -------------------------------------------------------
# Used for: vision analysis (gpt-4o / gpt-5), image generation
# (gpt-image-1 / gpt-image-2), speech-to-text (gpt-4o-mini-transcribe / whisper-1).
# Get a key: https://platform.openai.com/api-keys
# Make sure the account has GPT-4o + image generation access funded with credits.
OPENAI_API_KEY=

# --- ElevenLabs (REQUIRED) ---------------------------------------------------
# Used for: text-to-speech narration of the room analysis.
# Get a key: https://elevenlabs.io/app/settings/api-keys
# Free tier is enough for a demo; paid tier removes character limits.
ELEVENLABS_API_KEY=

# --- Google Gemini / Veo 3 (REQUIRED) ----------------------------------------
# Used for: cinematic walk-through video generation (Veo 3).
# Get a key: https://aistudio.google.com/apikey
# Veo 3 is rate-limited and slow (30–120s per video) — pre-render the
# canonical walk-through and save to public/demo/canonical-walkthrough.mp4.
GEMINI_API_KEY=

# --- Vercel Blob (REQUIRED for photo upload) ---------------------------------
# Used for: storing user-uploaded room photos so the OpenAI vision API can
# fetch them by URL.
# Get a token: Vercel Dashboard → Storage → Blob → "Create" → copy
# BLOB_READ_WRITE_TOKEN. Locally you can run `vercel env pull .env.local`
# after linking the project.
# Docs: https://vercel.com/docs/vercel-blob
BLOB_READ_WRITE_TOKEN=

# --- Fal (OPTIONAL — image gen acceleration) ---------------------------------
# Used for: faster image generation if OpenAI image gen is too slow on demo day.
# Skip unless you actually wire it in. Get a key: https://fal.ai/dashboard/keys
FAL_KEY=


# -----------------------------------------------------------------------------
# 2. PUBLIC (NEXT_PUBLIC_*) — exposed to the browser
# -----------------------------------------------------------------------------

# --- External backend SDK base URL (DORMANT for hackathon) -------------------
# This template originally fronted an external backend via the auto-generated
# SDK in src/client/*.gen.ts. The hackathon uses Next.js Route Handlers
# instead, so this value is unused. Leaving the variable in place so the
# dormant code in src/lib/api-client.ts still type-checks.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
